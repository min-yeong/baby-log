{
  "expo": {
    "name": "베이비로그",
    "slug": "baby-log",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "baby-log",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF0F3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.babylog.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF0F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.babylog.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "아기 사진을 일기에 첨부하기 위해 사진 접근 권한이 필요해요.",
          "cameraPermission": "아기 사진을 찍기 위해 카메라 접근 권한이 필요해요."
        }
      ]
    ]
  }
}
